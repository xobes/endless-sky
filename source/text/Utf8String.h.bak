//     iterator begin() { return iterator(FROM); }
//     iterator end() { return iterator(TO >= FROM? TO + 1 : TO - 1); }
// };

class Utf8String {
public:
	class Utf8StringIterator {
	public:
		explicit Utf8StringIterator(std::string *data, size_t pos = 0);
		Utf8StringIterator(std::string *data, size_t pos, char32_t codepoint);
		char32_t operator*() const;
		Utf8StringIterator &operator++();
		bool operator!=(const Utf8StringIterator &other) const;

	private:
		std::string *data;
		size_t pos = 0;
		char32_t codepoint = '\0';
	};

	Utf8String() = default;
	explicit Utf8String(const std::string &dataIn);
	Utf8String(const Utf8String &) = default;
	Utf8String(Utf8String &&) = default;
	Utf8String &operator=(const Utf8String &) = default;
	Utf8String &operator=(Utf8String &&) = default;
	Utf8StringIterator begin();
	Utf8StringIterator end();


private:
	std::string data;
};

inline Utf8String::Utf8StringIterator::Utf8StringIterator(std::string* data, size_t pos)
	: data(data), pos(pos)
{
	codepoint = Utf8::DecodeCodePoint(*data, this->pos);
}

inline Utf8String::Utf8StringIterator::Utf8StringIterator(std::string* data, size_t pos, char32_t codepoint)
	: data(data), pos(pos), codepoint(codepoint)
{
}

inline char32_t Utf8String::Utf8StringIterator::operator*() const
{
	assert((data && codepoint) && "Trying to deference invalidated iterator!");
	return codepoint;
}

inline Utf8String::Utf8StringIterator & Utf8String::Utf8StringIterator::operator++()
{
	codepoint = Utf8::DecodeCodePoint(*data, pos);
	return *this;
}

inline bool Utf8String::Utf8StringIterator::operator!=(const Utf8StringIterator& other) const
{
	return pos != other.pos;
}

inline Utf8String::Utf8String(const std::string& dataIn)
	: data(dataIn)
{
}

// Skip to the next unicode code point after pos in utf8.
// Return string::npos when there are no more code points.
// size_t new_pos = NextCodePoint(const std::string &str, std::size_t pos);

// Returns the start of the unicode code point at pos in utf8.
// std::size_t CodePointStart(const std::string &str, std::size_t pos);

// Decodes a unicode code point in utf8.
// Invalid codepoints are converted to 0xFFFFFFFF.
// pos skips to the next unicode code point after pos in utf8,
// or is set string::npos when there are no more code points.
// char32_t DecodeCodePoint(const std::string &str, std::size_t &pos);

inline Utf8String::Utf8StringIterator Utf8String::begin()
{
	return Utf8String::Utf8StringIterator(&data);
}

inline Utf8String::Utf8StringIterator Utf8String::end()
{
	return {&data, data.size(), '\0'};
}